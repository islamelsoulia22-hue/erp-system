# Copy to .env (never commit .env). Service role key must NEVER be here.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Update manifest for force-update checks (set automatically by CI release).
# Private repo -> hosted on Supabase Storage (public bucket); explicit URL wins,
# otherwise derived as $SUPABASE_URL/storage/v1/object/public/$RELEASES_BUCKET/update.json
UPDATE_MANIFEST_URL=
RELEASES_BUCKET=releases
